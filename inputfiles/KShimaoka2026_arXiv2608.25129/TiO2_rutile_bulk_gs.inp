&calculation
  theory = 'dft'
/

&control
  sysname = 'TiO2'
/

&units
  unit_system = 'a.u.'
/

&parallel
  nproc_k = 1
  nproc_rgrid(1)=1
  nproc_rgrid(2)=1
  nproc_rgrid(3)=1
  nproc_ob = 1
/

&system
  yn_periodic = 'y'
  al(1:3) =  8.448d0,8.448d0, 5.295d0
  nelem  = 2
  natom  = 6
  nelec  = 48
  nstate = 48
/

&pseudo
  file_pseudo(1) = './Ti.psp8'
  izatom(1) = 22

  file_pseudo(2) = './O.psp8'
  izatom(2) = 8

/

&functional
  xc = 'PZ'
/

&rgrid
  num_rgrid(1:3) = 24, 24, 16
/

&kgrid
  num_kgrid(1:3) = 4, 4, 6
/

&scf
  nscf      = 300
  threshold = 1.0d-9
/

&analysis
  yn_out_dos = 'y'
  yn_out_dos_set_fe_origin = 'y'
/



&atomic_red_coor
  'atom' 0.00 0.00 0.00 1
  'atom' 0.50 0.50 0.50 1
  'atom' 0.30 0.30 0.00 2
  'atom' 0.69 0.69 0.00 2
  'atom' 0.19 0.80 0.50 2
  'atom' 0.80 0.19 0.50 2
/




