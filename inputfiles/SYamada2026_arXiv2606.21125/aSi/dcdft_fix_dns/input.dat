&calculation
  theory = 'dft'
!  theory = 'tddft_pulse'
!  theory = 'tddft_response'
  yn_dc = y  
/

&dc
! yn_dc_lcfo=n
num_fragment = 4, 4, 4
nproc_rgrid_tot = 4, 8, 8
! product(nproc_rgrid_tot) == product(num_fragment) * nproc_ob * product(nproc_rgrid)
nstate_frag = 512
num_rgrid_buffer = 20,20,20
lambda_cut=1d-7
energy_cut=0.1
/

&control
  sysname = 'aSi'
!  sysname = 'aSi_int1e12'
!  sysname = 'aSi_int1e9'
!  sysname = 'aSi_lr'
  write_gs_restart_data='no'
!  method_wf_distributor = 'slice'
!  yn_restart=y
!  yn_reset_step_restart=y
/

&units
  !units used in input and output files
  unit_system = 'A_eV_fs'
/

&parallel
  nproc_k=1
  nproc_ob=4
  nproc_rgrid=1,1,1
/

&system
  !periodic boundary condition
  yn_periodic = 'y'
  temperature_k=300.0
  !grid box size(x,y,z)
  al = 21.9679712862 , 21.9679712862 , 21.9679712862
  !number of elements, atoms, electrons and states(bands)
  nelem  = 1
  natom  = 512
  nelec  = 2048
  nstate = 1048
  file_atom_coor="atom.txt"
/

&pseudo
  !name of input pseudo potential file
  file_pseudo(1) = 'Si_rps.dat'
  !atomic number of element
  izatom(1) = 14
  !angular momentum of pseudopotential that will be treated as local
  lloc_ps(1) = 2
  lmax_ps(1) = 2  
  !--- Caution -------------------------------------------!
  ! Index must correspond to those in &atomic_red_coor.   !
  !-------------------------------------------------------!
/
 
&functional
  xc = 'PZ'
/
 
&rgrid 
  !number of spatial grids(x,y,z)
  num_rgrid(1:3) = 80,80,80
/
  
&kgrid
  !number of k-points(x,y,z)
  num_kgrid(1:3) = 1, 1, 1
/

&scf
  method_init_density=read_dns_cube
!  nscf_init_mix_zero=100
  yn_preconditioning='y'
  ncg = 3
  nscf      = 200
  method_mixing = 'simple'
  mixrate = 0.0
  threshold = 0.0
/

&analysis
 de = 0.05
! yn_out_dns=y
! yn_out_dos = 'y'
! yn_out_pdos = 'y'
/ 

