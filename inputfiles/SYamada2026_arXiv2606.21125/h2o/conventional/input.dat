&calculation
  theory = 'dft'
!  theory = 'tddft_pulse'
!  theory = 'tddft_response'
!  yn_conventional_from_dcdft='y'
/

&control
  sysname='h2o'
!  yn_restart='y'
!  yn_reset_step_restart='y'
  write_gs_restart_data='no'
!  method_wf_distributor='slice'  
/

&units
  unit_system = 'A_eV_fs'
/

&parallel
  nproc_k = 1
!  nproc_ob = 512
!  nproc_rgrid = 1,2,2
  nproc_ob = 4
  nproc_rgrid(1:3) = 8, 8, 8
/

&system
  yn_periodic = 'y'
  al = 35.000000, 35.000000, 35.000000
  nelem = 2
  natom = 4134
  nelec = 11024
  nstate = 5520
  file_atom_coor = 'atom_coor.txt'
/

&pseudo
  izatom(2) = 8
  izatom(1) = 1
  file_pseudo(2) = 'O_rps.dat'
  lloc_ps(2) = 1
  file_pseudo(1) = 'H_rps.dat'
  Lmax_ps(1) = 0
  lloc_ps(1) = 0
/

&functional
  xc = 'PZ'
/

&rgrid
  num_rgrid(1:3) = 160,160,160
/

&kgrid
  num_kgrid(1:3) = 1,1,1
/

&scf
  nscf = 500
  ncg = 3
  method_mixing = 'simple'
  mixrate = 0.1
  threshold = 1.0d-9
  yn_preconditioning = 'y'
  nscf_init_no_diagonal = 0
  nscf_init_mix_zero= 10
  method_init_density='pp'
/

&analysis
  yn_out_dns='y'
/

&tgrid
  dt = 0.001d0
  nt = 20000
/

&emfield
!  ae_shape1 = 'impulse'
  ae_shape1 = 'Acos6'
  I_wcm2_1 = 1.0d13
  tw1 = 20.0d0
  omega1 = 1.55d0
  epdir_re1(1:3) = 0.0d0, 0.0d0, 1.0d0
/
