&calculation
!  theory = 'dft'
  theory = 'tddft_pulse'
!  yn_dc = 'y'
  yn_conventional_from_dcdft='y'  
/

&dc
! # of MPI processes == product(nproc_rgrid_tot) == product(num_fragment) * nproc_ob * product(nproc_rgrid) 
  num_fragment = 8,8,8
  nproc_rgrid_tot = 8,16,16
  nstate_frag = 250

  num_rgrid_buffer = 16,16,16
  lambda_cut = 1d-7
  energy_cut = 0.1
!  yn_dc_lcfo='n'
/

&control
  sysname='h2o'
  write_gs_restart_data='no'
/

&units
  unit_system = 'A_eV_fs'
/

&parallel
  nproc_k = 1
  nproc_ob = 512
  nproc_rgrid(1:3) = 1, 2, 2
/

&system
  yn_periodic = 'y'
  al = 35.000000, 35.000000, 35.000000
  nelem = 2
  natom = 4134
  nelec = 11024
  nstate = 5520
  file_atom_coor = 'atom_coor.txt'
!  temperature_k = 300.0
/

&pseudo
  izatom(2) = 8
  izatom(1) = 1
  file_pseudo(2) = 'O_rps.dat'
  lloc_ps(2) = 1
  file_pseudo(1) = 'H_rps.dat'
  Lmax_ps(1) = 0
  lloc_ps(1) = 0
/

&functional
  xc = 'PZ'
/

&rgrid
  num_rgrid(1:3) = 160,160,160
/

&kgrid
  num_kgrid(1:3) = 1,1,1
/

&scf
  nscf = 1500
  ncg = 1
  method_mixing = 'simple'
  mixrate = 0.05
!  alpha_mb = 0.01
  threshold = 1.0d-9
  yn_preconditioning = 'y'
/

&analysis
!  yn_out_dns='y'
/

&tgrid
  dt = 0.001d0
  nt = 20000
/

&emfield
!  ae_shape1 = 'impulse'
  ae_shape1 = 'Acos6'
  I_wcm2_1 = 1.0d13
  tw1 = 20.0d0
  omega1 = 1.55d0
  epdir_re1(1:3) = 0.0d0, 0.0d0, 1.0d0
/
